{
  "tests": [
    {
      "name": "GET all references",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "POST upsert customer",
      "method": "POST",
      "path": "/",
      "body": {"kind": "customers", "item": {"id": "test-cust-1", "name": "Тест ООО", "director": "Иванов", "inn": "123", "address": "Москва"}},
      "expectedStatus": 200,
      "expectedBody": {"item": {"id": "test-cust-1", "name": "Тест ООО"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE customer",
      "method": "DELETE",
      "path": "/",
      "body": {"kind": "customers", "id": "test-cust-1"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST upsert passport",
      "method": "POST",
      "path": "/",
      "body": {"resource": "passport", "reportId": "test-rep-1", "massif": "Z", "data": {"objectName": "Тестовый участок"}},
      "expectedStatus": 200,
      "expectedBody": {"passport": {"reportId": "test-rep-1", "massif": "Z"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET passport",
      "method": "GET",
      "path": "/?resource=passport&reportId=test-rep-1",
      "expectedStatus": 200,
      "expectedBody": {"passport": {"reportId": "test-rep-1", "massif": "Z"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE passport",
      "method": "DELETE",
      "path": "/",
      "body": {"resource": "passport", "reportId": "test-rep-1"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST upsert report",
      "method": "POST",
      "path": "/",
      "body": {"resource": "reports", "item": {"id": "test-rep-x", "title": "Тестовый отчёт", "year": "2024"}},
      "expectedStatus": 200,
      "expectedBody": {"report": {"id": "test-rep-x", "title": "Тестовый отчёт", "year": "2024"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET reports list",
      "method": "GET",
      "path": "/?resource=reports",
      "expectedStatus": 200
    },
    {
      "name": "GET single report",
      "method": "GET",
      "path": "/?resource=reports&id=test-rep-x",
      "expectedStatus": 200,
      "expectedBody": {"report": {"id": "test-rep-x", "title": "Тестовый отчёт"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE report",
      "method": "DELETE",
      "path": "/",
      "body": {"resource": "reports", "id": "test-rep-x"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST save abstract block",
      "method": "POST",
      "path": "/",
      "body": {"resource": "block", "block": "abstract", "reportId": "test-blk-1", "data": {"keywords": "вода, запасы"}},
      "expectedStatus": 200,
      "expectedBody": {"data": {"keywords": "вода, запасы"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "GET abstract block",
      "method": "GET",
      "path": "/?resource=block&block=abstract&reportId=test-blk-1",
      "expectedStatus": 200,
      "expectedBody": {"data": {"keywords": "вода, запасы"}},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST save study block (array)",
      "method": "POST",
      "path": "/",
      "body": {"resource": "block", "block": "study", "reportId": "test-blk-1", "data": [{"id": "p1", "name": "Скв. 1"}]},
      "expectedStatus": 200
    },
    {
      "name": "DELETE abstract block",
      "method": "DELETE",
      "path": "/",
      "body": {"resource": "block", "block": "abstract", "reportId": "test-blk-1"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "POST section meta",
      "method": "POST",
      "path": "/",
      "body": {"resource": "section_meta", "reportId": "test-blk-1", "tabId": "abstract", "data": {"authors": ["Иванов И.И."]}},
      "expectedStatus": 200
    },
    {
      "name": "GET section meta",
      "method": "GET",
      "path": "/?resource=section_meta&reportId=test-blk-1&tabId=abstract",
      "expectedStatus": 200
    },
    {
      "name": "DELETE section meta",
      "method": "DELETE",
      "path": "/",
      "body": {"resource": "section_meta", "reportId": "test-blk-1", "tabId": "abstract"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE study block",
      "method": "DELETE",
      "path": "/",
      "body": {"resource": "block", "block": "study", "reportId": "test-blk-1"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "DELETE all section meta of report",
      "method": "DELETE",
      "path": "/",
      "body": {"resource": "section_meta", "reportId": "test-blk-1"},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    }
  ]
}